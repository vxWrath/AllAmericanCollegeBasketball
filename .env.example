# Application
APP_ENV=                        # dev | qa | prod
APP_PORT=                       # port the app listens on
LOG_LEVEL=                      # debug | info | warning | error

# PostgreSQL — Docker Compose assembles DATABASE_URL and ALEMBIC_DATABASE_URL from these
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432

# Redis
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# Sessions
SESSION_SECRET=                 # long random string, never commit a real value
SESSION_EXPIRE_SECONDS=86400
